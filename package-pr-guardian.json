{
  "name": "@pr-guardian/core",
  "version": "1.0.0",
  "description": "Bulletproof PR protection - catches breaking changes that humans, TypeScript, and ESLint miss",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pr-guardian": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "prepublishOnly": "npm run build && npm test",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "pr-review",
    "code-analysis",
    "breaking-changes",
    "ci-cd",
    "typescript",
    "javascript",
    "angular",
    "react",
    "vue",
    "azure-devops",
    "github-actions",
    "gitlab-ci",
    "static-analysis",
    "code-quality",
    "automated-review"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/pr-guardian.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/pr-guardian/issues"
  },
  "homepage": "https://github.com/your-org/pr-guardian#readme",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "files": ["dist", "README.md", "LICENSE", "templates"],
  "peerDependencies": {
    "@typescript-eslint/parser": ">=6.0.0",
    "typescript": ">=4.7.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "glob": "^10.3.10",
    "ora": "^7.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  }
}
